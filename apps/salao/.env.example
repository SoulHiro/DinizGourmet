# Banco local do salão. Em dev: `pnpm db:local` sobe um Postgres embutido.
DATABASE_URL=postgres://salao:salao@localhost:5433/xisdiniz_salao
DATABASE_URL_TEST=postgres://salao:salao@localhost:5433/xisdiniz_salao_test

PORT=3000
HOST=::

# IPs dos celulares que acessam o dev server (separados por vírgula)
ALLOWED_DEV_ORIGINS=

# "arquivo" (dev, grava tickets em IMPRESSAO_DIR) ou "windows" (produção)
IMPRESSAO_DRIVER=arquivo
IMPRESSAO_DIR=./.tickets
# Colunas por linha: 48 para bobina de 80mm com fonte A
IMPRESSAO_LARGURA=48

# HTTPS na rede local (necessário para instalar o app no celular)
COOKIE_SECURE=false
HTTPS_KEY=
HTTPS_CERT=

SENTRY_DSN=
# PC850_MULTILINGUAL | PC860_PORTUGUESE | WPC1252 | ASCII (sem acentos, funciona em qualquer impressora)
IMPRESSAO_CODEPAGE=PC850_MULTILINGUAL
IMPRESSAO_TIMEOUT_JOB_MS=20000

# Pedido de ajuda sem resposta vira alerta para o gerente após (segundos)
AJUDA_ESCALAR_APOS_SEGUNDOS=120

# Chamado do cliente sem atendimento vai para o gerente após (segundos)
CHAMADO_ESCALAR_APOS_SEGUNDOS=180
# Endereço no QR das mesas, ex.: https://192.168.1.50:3000 (vazio = o da tela do gerente)
PUBLIC_URL=

# Pasta das fotos e vídeos do cardápio
MIDIA_DIR=./midia
