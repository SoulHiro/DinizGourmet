{
  "name": "salao",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de pedidos do salão Xis Diniz (painel do garçom). Roda local no Windows do restaurante.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./src/app --ignore ./.next server.ts",
    "build": "next build && node scripts/build-server.mjs",
    "start": "node --enable-source-maps dist/iniciar.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "tsx scripts/db-local.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "cardapio:atualizar": "tsx scripts/cardapio-oficial.ts",
    "fotos:importar": "tsx scripts/importar-fotos.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "impressao:spike": "tsx ops/spike-impressao.ts",
    "servico:instalar": "node ops/servico.mjs instalar",
    "servico:remover": "node ops/servico.mjs remover",
    "carga": "tsx ops/teste-carga.ts"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/node": "^11.0.0",
    "@tanstack/react-query": "^5.103.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "node-thermal-printer": "^4.6.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@ssxv/node-printer": "^1.1.1",
    "node-windows": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
